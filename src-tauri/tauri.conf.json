{
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "es-ES",
        "dialogImagePath": "./assets/dialog.bmp",
        "bannerPath": "./assets/banner.bmp"
      },
      "nsis": {
        "languages": [
          "Spanish"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "publisher": "Lyra",
    "shortDescription": "Lyra",
    "category": "Utility",
    "copyright": "Copyright (c) 2024 Lyra",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/lyra.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "./linux/lyra.desktop.hbs"
      }
    }
  },
  "productName": "Lyra",
  "mainBinaryName": "Lyra",
  "version": "2.0.10",
  "identifier": "com.lyra.dev",
  "plugins": {
    "shell": {
      "open": "^https?://.*$"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxQ0FBQzcxQkUwQjQ3NUIKUldSYlJ3dStjYXpLMFN4ejREUHQwaXlsT2FjejhITHRaRzVpR3pwN204cmM0WWdQaytIWGZZY3kK",
      "endpoints": [
        "https://github.com/gixi404/lyra/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "title": "Lyra",
        "width": 1100,
        "height": 600,
        "decorations": true,
        "center": true,
        "focus": true,
        "visible": false,
        "useHttpsScheme": true,
        "backgroundColor": "#101010"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' blob:;"
    }
  }
}
