{
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "wix": {
        "language": "es-ES",
        "dialogImagePath": "./assets/dialog.webp",
        "bannerPath": "./assets/banner.webp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "publisher": "Lyra",
    "shortDescription": "Lyra",
    "category": "Utility",
    "copyright": "Copyright (c) 2024 Lyra",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/lyra.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "./linux/lyra.desktop.hbs"
      }
    }
  },
  "productName": "Lyra",
  "mainBinaryName": "Lyra",
  "version": "2.0.0",
  "identifier": "com.lyra.dev",
  "plugins": {
    "shell": {
      "open": "^https?://.*$"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "minWidth": 600,
        "minHeight": 450,
        "resizable": true,
        "title": "Lyra",
        "width": 1100,
        "height": 600,
        "decorations": true,
        "center": true,
        "focus": true,
        "visible": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self';"
    }
  }
}