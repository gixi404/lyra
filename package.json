    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.5.0",
    "zustand": "^4.5.4"
