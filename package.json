{
  "name": "lyra",
  "private": true,
  "version": "2.0.15",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "pnpm lint && pnpm typecheck && pnpm lint:rust",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "newversion": "node scripts/newversion.js",
    "revertversion": "node scripts/revertversion.js"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
